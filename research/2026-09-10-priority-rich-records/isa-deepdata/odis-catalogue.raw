            <style type="text/css">

                /* use waves image as background */
                body {
                    //background: linear-gradient(180deg, #FFFFFF 20%, #00517fff 100%);
                    //background-color: #00517f;
                    background-image: url('/assets/deZeeDrieLarge.svg');
                    background-repeat: no-repeat;
                    background-attachment: fixed;
                    background-size: 100%;
                    width: 100%;
                    height: auto;
                }

                /* make the background lighter where we show content */
                #jumbo {
                    background: rgba(240, 252, 255, 0.9);
                    margin-top: 70px;
                    padding-top: 40px;
                    height: auto;
                    padding-bottom: 70px;
                }

                /* add asterisk before the label text for required fields */
                .required:before {
                    content:"* ";
                }

                /* add stamp on the homepage */
                div.putStampHere:after
                {
                    content:'Suggest an entry';
                    position:absolute;
                    top:-40px;
                    left:-60px;
                    z-index:1;
                    font-family:Arial,sans-serif;
                    -webkit-transform: rotate(45deg); /* Safari */
                    -moz-transform: rotate(45deg); /* Firefox */
                    -ms-transform: rotate(45deg); /* IE */
                    -o-transform: rotate(45deg); /* Opera */
                    transform: rotate(45deg);
                    font-size:40px;
                    color:#c00;
                    background:#fff;
                    border:solid 4px #c00;
                    padding:5px;
                    border-radius:25px;
                    zoom:1;
                    filter:alpha(opacity=20);
                    opacity:0.2;
                    -webkit-text-shadow: 0 0 2px #c00;
                    text-shadow: 0 0 2px #c00;
                    box-shadow: 0 0 2px #c00;
                    cursor: pointer;
                }

                .break-all {
                    word-break: break-all;
                }

                .hideSelections+.select2-container .select2-selection--multiple .select2-selection__choice {
                     display: none;
                }

                .button-wrap {
                    white-space: normal;
                }

                .w-min-content {
                    width: min-content;
                }

                .min-width-auto {
                    min-width: auto;
                }

                .bg-info-border {
                    background: white;
                }

                .bg-info-border:hover {
                    background: #17a2b8;
                }

            </style>


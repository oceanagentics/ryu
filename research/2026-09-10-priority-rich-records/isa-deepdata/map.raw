                        //let $content = $("<div" + " data-category=" + parseInt(id) + " class='element-item " + page_number + " " + object_id + " " + uidi + "'>" + "<object id=img-sample-" + uidi + " data=" + data + " class='photo-gallery-highlight-off' style='max-width: 100%; max-height: 100%'></object></div>");


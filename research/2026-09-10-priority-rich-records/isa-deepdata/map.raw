        // Get CTD Stations
        function get_stations(onlyGetStationIds, selectedStationId, getNetCDFOutput, forceReload, highlightSelection, onlyGetContractIds, onlyGetCruiseLeg, recordsExport, getCTDCount, getPlottingJson){
            $("#processing-spinner").show();
            $("#tabs").addClass('disabledButton');
            $('#downloadsError').empty();
            //if ($("#selectStation").children().length > 0 && onlyGetStationIds === "true" && forceReload === "false"){
            //    return false;
            //}
            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();
            // console.log('locationIds');
            // console.log(locationIds);

            let noSelection = false;
            if(contractorIds.length === 0 && alreadyCreatedFiltersFromJson)
                noSelection = true;

            // Set response type to 'json' for the drop-down lists in the UI
            let respType = 'json';

            // Set the response type to 'blob' for the profile images
            let xhrF = {};
            if (selectedStationId !== "none" && highlightSelection === "true") {
                respType = 'blob';
                xhrF = {responseType: 'blob'};
            }

            // Set the response type to 'document' for the zip/csv/xls exports
            let netCDFOutput = "false";
            if (getNetCDFOutput === "true" && selectedStationId !== "none") {
                netCDFOutput = "true";
                respType = 'document';
                xhrF = {responseType: 'blob'};
            }

            if (recordsExport === "true") {
                respType = 'records'
                xhrF = {responseType: 'blob'};
            }

            if (getCTDCount === 'true') {
                respType = 'json'
                xhrF = {}
            }

            if (getPlottingJson === 'true') {
                respType = 'json'
                xhrF = {}
            }

            let lineOrScatter = 'line';
            lineOrScatter = $("input[name='lineorscatter']:checked").val()

            //queryData = {'Method': method, 'NoSelection': noSelection, 'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds};
            let queryData = {
                'ContractorIds': contractorIds,
                'ContractStatusIds': contractStatusIds,
                'SponsoringStateIds': sponsoringStateIds,
                'MineralTypeIds': mineralTypeIds,
                'LocationIds': locationIds,
                "Theme": "",
                "ExportFormat": respType,
                "StationIds": [selectedStationId],
                "OnlyStationIds": onlyGetStationIds,
                "OnlyContractIds": onlyGetContractIds,
                "OnlyCruiseLeg": onlyGetCruiseLeg,
                "AllStationIds": "false",
                "Parameters": ["Temperature cast"],
                "netCDFOutput": netCDFOutput,
                "ParameterStationIds": "",
                "SelectedContractId": $('#selectCTDContract').val(),
                "SelectedCruiseLeg": $('#selectCTDCruiseLeg').val(),
                "SelectedStationID": $('#selectStation').val(),
                'APEI': [],
                'GetCTDCount': getCTDCount,
                'GetPlottingJson': getPlottingJson,
                'PlotType': lineOrScatter
            };
            $.when($.ajax({
                url: 'mssql_get_ctd_data/',
                timeout: 600000,
                ajax: true,
                responseType: respType,
                type: 'POST',
                xhrFields: xhrF,
                contentType: "application/json",
                data: JSON.stringify(queryData),
                beforeSend: function (xxx) {
                    $("#processing-spinner").show();
                    $("#tabs").addClass('disabledButton');
                },
                failure: function (error) {
                    console.log('There was an error running the query');
                    console.log(error);
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                    $("#ctdImageContainer").attr('src', '');
                    $('#chartCtdDiv').empty();
                    $('#chartCtdDiv').hide();
                    $('#downloadsError').append('<p>No data returned to plot.</p>');
                },
                success: function (data) {
                    // console.log('ctd data stuff *********************************')
                    // console.log(respType);
                    // console.log(data);
                    if (respType === 'document') {
                        //console.log('Trying to export netCDF file after success...');
                        // Export netCDF files to zip file
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        let binaryData = [];
                        binaryData.push(data);
                        anchor.href = url.createObjectURL(new File(binaryData, {type: "application/zip"}));
                        anchor.download = selectedStationId + '.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function () {
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    } else if (respType === 'records') {
                        //console.log('Trying to export netCDF file after success...');
                        // Export netCDF files to zip file
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        let binaryData = [];
                        binaryData.push(data);
                        anchor.href = url.createObjectURL(new File(binaryData, {type: "application/zip"}));
                        anchor.download = 'ctd_records_export.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function () {
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    } else if (onlyGetStationIds === "true") {
                        populateStations(data['stations']);
                        // populateStationParameters(data['stations']['plot_parameters']);
                        // queryPointsLayerCTD(data['stations'], 0);
                    } else if (onlyGetContractIds === "true") {
                        populateContractIds(data['contract_ids']);
                    } else if (onlyGetCruiseLeg === "true") {
                        populateCruiseLeg(data['cruise_leg']);
                    } else if (getCTDCount === "true") {
                        populateCTDCount(data['ctd_count']);
                    } else if (getPlottingJson === "true") {
                        let markerSize = 6;
                        let lineWidth = 0;
                        if (lineOrScatter === 'line') {
                            markerSize = 0;
                            lineWidth = 2;
                        }
                        if (lineOrScatter === 'both') {
                            markerSize = 6;
                            lineWidth = 2;
                        }
                        //console.log(data);
                        $('#chartCtdDiv').show();
                        let chart = JSC.chart('chartCtdDiv', {
                            debug: false,
                            type: 'horizontalSpline',
                            axisToZoom: 'xy',
                            //boxVisible: true,
                            height: 500,
                            //chartArea: {
                            //    fill: {
                            //image: '/static/img/logo.png'
                            //    }
                            //},
                            events: {
                                beforeExport: function() {
                                    this.annotations.add({
                                        id: 'tmpcopyright',
                                        label_text: 'International Seabed Authority (C) 2023',
                                        position: 'outside top center'
                                        //position: 'inside center center'
                                    });
                                },
                                afterExport: function() {
                                    this.annotations('tmpcopyright').remove();
                                }
                            },
                            box: {
                                padding: [5,5,5,5],
                                visible: true,
                                corners: 'round',
                                radius: 5,
                                outline: { color: '#000000', width: 2 },
                            },
                            legend_visible: true,
                            legend: {
                                layout: 'horizontal',
                                position: 'bottom',
                                //offset: '20,-200',
                                fill: '#ffffff',
                                boxVisible: true,
                                corners: 'round',
                                radius: 5,
                                margin_left: 5,
                                margin_right: 5,
                                margin_top: 5,
                                margin_bottom: 5,
                                outline: { color: '#000000', width: 1 },
                                defaultEntry: {
                                    iconWidth: 25,
                                    //value: 0,
                                    //name: '<span style="width:65px">%name</span> (%attributes.unit)',
                                    padding: 4,
                                    style: {
                                        color: '#3A5254',
                                        fontSize: '8pt',
                                        fontStyle: 'italic',
                                        fontFamily: 'Arial',
                                        fontWeight: 'normal'
                                    },
                                    states: {
                                        hover_style: { color: '#FF5254' },
                                        hidden_style: { color: '#c2bec1' }
                                    }
                                }
                            },
                            xAxis: {
                                crosshair_enabled: true,
                                label: {text: 'Depth (m)',
                                    style: {fontWeight: 'bold'}
                                },
                                scale: { type: 'stacked', invert: true }
                            },
                            yAxis: { orientation: 'bottom', formatString: '', scale: {invert: false} },
                            defaultPoint: {
                                tooltip:
                                    '%icon <span style="width:100px">%seriesName</span> %yValue (%unit)',
                                //'%yValue (%unit)',
                                //marker: { size: 6, color: 'darken' },
                                marker: {
                                    type: 'circle',
                                    size: markerSize,
                                    fill: 'white',
                                    outline: { width: 1, color: 'currentColor' }
                                }
                            },
                            defaultTooltip: {
                                combined: true,
                                /* For a list of possible tokens, visit Point List Tokens section here:
                                 * https://jscharting.com/tutorials/js-chart-labels/token-reference/
                                 */
                                label_text: 'Depth (m): %xValue<hr>%points'
                            },
                            defaultSeries: {
                                line: {
                                    width: lineWidth
                                }
                                //firstPoint_label_text: '<b>%seriesName</b>',
                                //defaultPoint_tooltip: '%icon <span style="width:65px">%seriesName</span> %xValue',
                                //defaultPoint_marker: {
                                //    type: 'circle',
                                //    size: 6,
                                //    fill: 'white',
                                //    outline: { width: 1, color: 'currentColor' }
                                //}
                            },
                            title: {
                                label: {
                                    text: '<b>Contract:</b> ' + data['contractid'] + " >> <b>Cruise/Leg:</b> " + data['cruiseleg'] + " >> <b>Station:</b> " + data['station'] + '',
                                    //style_fontWeight: 'bold',
                                },
                            },
                            series: data['series']['series'],
                            // Shortcut to toolbar_items_export_visible property
                            export: true
                        });

                        let titleField = document.getElementById('titleField');
                        let authorField = document.getElementById('authorField');
                        let subjectField = document.getElementById('subjectField');
                        let keywordsField = document.getElementById('keywordsField');
                        let commentField = document.getElementById('commentField');
                        let ratingField = document.getElementsByName('ratingField');
                        let imageFormatElement = document.getElementById('imgFormat');
                        hideFields(imageFormatElement.options[0].text);
                        imageFormatElement.addEventListener('change', function() {
                            hideFields(this.options[this.selectedIndex].text);
                        });

                        function hideFields(text) {
                            let title = document.getElementById('title');
                            let author = document.getElementById('author');
                            let subject = document.getElementById('subject');
                            let keywords = document.getElementById('keywords');
                            let comment = document.getElementById('comment');
                            let rating = document.getElementById('rating');
                            if (text == 'png' || text == 'svg') {
                                title.style.display = 'none';
                                author.style.display = 'none';
                                subject.style.display = 'none';
                                keywords.style.display = 'none';
                                comment.style.display = 'none';
                                rating.style.display = 'none';
                            }
                            if (text == 'pdf') {
                                title.style.display = 'block';
                                author.style.display = 'block';
                                subject.style.display = 'block';
                                keywords.style.display = 'block';
                                comment.style.display = 'none';
                                rating.style.display = 'none';
                            }
                            if (text == 'jpg') {
                                title.style.display = 'block';
                                author.style.display = 'block';
                                subject.style.display = 'block';
                                keywords.style.display = 'block';
                                comment.style.display = 'block';
                                rating.style.display = 'block';
                            }
                        }
                        function exportImg() {
                            if (chart) {
                                for (let i = 0; i < ratingField.length; i++) {
                                    if (ratingField[i].checked) {
                                        let rating = i + 1;
                                    }
                                }
                                let text = imageFormatElement.options[imageFormatElement.selectedIndex].text;
                                chart.exportImage({
                                    imageType: text,
                                    title: titleField.value === '' ? titleField.placeholder : titleField.value,
                                    author: authorField.value === '' ? authorField.placeholder : authorField.value,
                                    subject: subjectField.value,
                                    keywords: keywordsField.value,
                                    comment: commentField.value,
                                    rating: rating
                                });
                            }
                        }
                        function printChart() {
                            if (chart) {
                                chart.print();
                            }
                        }

                        function attachEvents() {
                            let exportBtn = document.getElementById('exportBtn');
                            let printBtn = document.getElementById('printBtn');

                            exportBtn.addEventListener('click', exportImg);
                            printBtn.addEventListener('click', printChart);
                        }

                        attachEvents();

                        //$('#chartCtdDivExport').show();

                        // Pan the map
                        // console.log(data['series']);
                        let lon = parseFloat(data['series']['longitude']);
                        let lat = parseFloat(data['series']['latitude']);
                        $('#ctdCurrentStation').attr(
                            {
                                'data-lonlat': [lon,lat],
                                'data-objectid': data['series']['objectid'],
                                'data-stationid': data['series']['stationid'],
                                'data-cruiseleg': data['series']['cruiseleg'],
                                'data-contractorid': data['series']['contractorid']
                            })
                        //queryPointsLayerCTD([data['station']], 0);

                    } else if (respType === "blob") {
                        //let camera = document.getElementById('ctdImageContainer');
                        //let camera = $("#ctdImageContainer");
                        //camera.attr("src", 'data:image/png;base64,'+ btoa(data));
                        //let url = window.URL || window.webkitURL;
                        //img.src = url.createObjectURL(data);
                        //$("#ctdImageContainer").html('<img src="' + data + '" />');
                        $("#ctdImageContainer").attr('src', '');
                        let img = document.getElementById('ctdImageContainer');
                        let the_a = document.getElementById('ctdImageLink');
                        let url = window.URL || window.webkitURL;
                        img.src = url.createObjectURL(data);
                        the_a.href = url.createObjectURL(data);
                        the_a.download = selectedStationId;
                        //queryPointsLayerCTD([{"StationId": selectedStationId}], 0)
                        //console.log(selectedStationId);
                        if (highlightSelection) {
                            //queryPointsLayerCTD([{"ObjectID": selectedStationId}], 1)
                        }
                    } else { console.log('No CTD response was identified...')}

                },
                error: function (request, status, error) {
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                    $("#ctdImageContainer").attr('src', '');
                    $('#chartCtdDiv').empty();
                    $('#chartCtdDiv').hide();
                    $('#downloadsError').append('<p>No data returned to plot.</p>');
                    console.log(request);
                    console.log(status);
                    console.log(error);
                }
            })).done(function (data, textStatus, jqXHR) {
                $("#processing-spinner").hide();
                $("#tabs").removeClass('disabledButton');
                return data
            });

        }

        function get_initial_ctd_data_orig() {
            let ctdImageContainer = $('#ctdImageContainer');
            let ctdContractSelect = $('#selectCTDContract');
            if (ctdImageContainer.attr('src') === '' && ctdContractSelect.find("option").length === 0) {
                get_stations('false', 'none', 'false', 'true', 'false', 'true', 'false', 'false', 'false', 'false');
                get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
            } else if (ctdImageContainer.attr('src') === '') {
                //clearCtd();
                //get_stations('false', 'none', 'false', 'true', 'false', 'true', 'false', 'false', 'false', 'false');
                get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
            } else {
                if (ctdContractSelect.find("option").length === 0) {
                    clearCtd();
                    get_stations('false', 'none', 'false', 'true', 'false', 'true', 'false', 'false', 'false', 'false');
                    get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
                } else {
                    get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
                }
                get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
            }
        }

        function get_initial_ctd_data() {
            const targetNode = document.getElementById('ctdCurrentStation');
            let ctdContractSelect = $('#selectCTDContract');
            if (ctdContractSelect.find("option").length === 0) {
                clearCtd();
                get_stations('false', 'none', 'false', 'true', 'false', 'true', 'false', 'false', 'false', 'false');
                get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
            } else {
                get_stations('false', 'none', 'false', 'false', 'false', 'false', 'false', 'false', 'true', 'false');
                let x = parseInt(targetNode.getAttribute('data-refresh')) + 1
                $('#ctdCurrentStation').attr(
                    {
                        'data-refresh': x.toString()
                    })
            }
        }

        function populateContractIds(data) {
            //console.log('Populate stations');
            //console.log(data);
            $('#selectCTDContract').empty();
            $('#selectCTDContract')
                .append($("<option></option>")
                    .attr("value","SelectContract")
                    .prop("disabled",true)
                    .prop("selected",true)
                    .text("Select Contract"));

            sortedData = _.sortBy(data, 'ContractID')
            $.each(sortedData, function(key, val){
                // console.log(key);
                // console.log(val);
                $('#selectCTDContract')
                    .append($("<option></option>")
                        .attr("data-objectid",val['ContractID'])
                        .attr("value",val['ContractID'])
                        .text(val['ContractID']));
            });
        }

        function populateCruiseLeg(data) {
            //console.log('Populate stations');
            //console.log(data);
            $('#selectCTDCruiseLeg').empty();
            $('#selectCTDCruiseLeg')
                .append($("<option></option>")
                    .attr("value","SelectCruiseLeg")
                    .prop("disabled",true)
                    .prop("selected",true)
                    .text("Select Cruise Leg"));

            sortedData = _.sortBy(data, 'Cruise_Leg')
            $.each(sortedData, function(key, val){
                // console.log(key);
                // console.log(val);
                $('#selectCTDCruiseLeg')
                    .append($("<option></option>")
                        .attr("data-objectid",val['Cruise_Leg'])
                        .attr("value",val['Cruise_Leg'])
                        .text(val['Cruise_Leg']));
            });
        }

        function populateCTDCount(data) {
            $('#AllCtdRecordsCount').empty();
            //console.log('populateCTDCount');
            //console.log(data);
            $('#AllCtdRecordsCount').append("<br><span>Number of records: " + data + "</span><br>");
            if (data > 1000000) {
                $('#RunCTDRecordsExport').hide();
                $('#RunCTDRecordsExportInfo').empty();
                $('#RunCTDRecordsExportInfo').append('<span>Use the Layers tab and de-select filters to reduce the CTD record count; otherwise, please contact the ISA Secretariat for custom data requests larger than 1M records.</span>');
            } else {
                $('#RunCTDRecordsExportInfo').empty();
                $('#RunCTDRecordsExport').show();
            }
        }

        function populateStations(data) {
            //console.log('Populate stations');
            //console.log(data);
            $('#selectStation').empty();
            $('#selectStation')
                .append($("<option></option>")
                    .attr("value","SelectStation")
                    .prop("disabled",true)
                    .prop("selected",true)
                    .text("Select Station"));

            sortedData = _.sortBy(data, 'StationId')
            $.each(sortedData, function(key, val){
                // console.log(key);
                // console.log(val);
                $('#selectStation')
                    .append($("<option></option>")
                        .attr("data-objectid",val['ObjectID'])
                        .attr("value",val['StationId'])
                        .text(val['StationId']));
            });
        }

        // ****************************************************************************************
        // Photo/Video Functions

        function onClickSampleImagePageNumber(obj) {
            let theSample = $(obj);
            let theSampleId = theSample[0].value;
            //console.log(obj);
            //console.log(theSampleId);
            $grid.isotope({ filter: theSampleId });
            $grid.isotope('updateSortData').isotope();
            //$grid.isotope('reloadItems');

            $("tr[class^=sample-image-tr][class^=sample]").show();
            $("tr[class^=sample-image-tr]:not("+theSampleId+")").hide();
        }

        function onClickResultImagePageNumber(obj) {
            let theSample = $(obj);
            let theSampleId = theSample[0].value;
            //console.log(obj);
            //console.log(theSampleId);
            $gridResults.isotope({ filter: theSampleId });
            $gridResults.isotope('updateSortData').isotope();
            //$grid.isotope('reloadItems');

            $("tr[class^=sample-image-result-tr][class^=sample]").show();
            $("tr[class^=sample-image-result-tr]:not("+theSampleId+")").hide();
        }

        function onClickResetSampleImageMapPoints(obj) {
            get_photos('true', '', 'false', 'true', 'false');
        }


        // Get Photos and Videos
        function get_photos(onlyGetStationIds, selectedStationId, getNetCDFOutput, forceReload, updateMap){
            $('#downloadsError').empty();
            $('#photoGallery').hide();
            $('#photoListing').hide();
            $('#photoGalleryResults').hide();
            $('#photoListingResults').hide();

            //$("#processing-spinner").show();
            //$("#tabs").addClass('disabledButton');

            //if ($("#selectStation").children().length > 0 && onlyGetStationIds === "true" && forceReload === "false"){
            //    return false;
            //}
            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();
            // console.log('locationIds');
            // console.log(locationIds);

            let noSelection = false;
            if(contractorIds.length === 0 && alreadyCreatedFiltersFromJson)
                noSelection = true;

            let respType = 'json';
            let xhrF = {};
            if (onlyGetStationIds !== "true") {
                respType = 'blob';
                xhrF = {responseType: 'blob'};
            }

            netCDFOutput = "false";
            if (getNetCDFOutput === "true") {
                netCDFOutput = "true";
                respType = 'document';
            }

            // Get whether this is point or trawl
            let radioValue = $("input[name='samplevstrawl']:checked").val();

            let photoNoPos = $("input[name='photonopos']:checked").val();

            //queryData = {'Method': method, 'NoSelection': noSelection, 'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds};
            let queryData = {'ContractorIds': contractorIds,
                'ContractStatusIds': contractStatusIds,
                'SponsoringStateIds': sponsoringStateIds,
                'MineralTypeIds': mineralTypeIds,
                'LocationIds': locationIds,
                "Theme": "",
                "ExportFormat": null,
                "StationIds": [selectedStationId],
                "OnlyStationIds": onlyGetStationIds,
                "AllStationIds": "false",
                "Parameters": ["Temperature cast"],
                "netCDFOutput": netCDFOutput,
                "ParameterStationIds": "",
                "selectedObjectID": selectedStationId,
                "sampleVersusTrawl": radioValue,
                'APEI': [],
                "photoNoPos": photoNoPos
            };
            $.when($.ajax({
                url: 'mssql_get_tbl_photos/',
                timeout: 600000,
                ajax: true,
                responseType: respType,
                type: 'POST',
                xhrFields: xhrF,
                contentType: "application/json",
                data: JSON.stringify(queryData),
                beforeSend: function(xxx) {
                    $("#processing-spinner").show();
                    $("#tabs").addClass('disabledButton');
                },
                failure: function (error) {
                    console.log('There was an error running the query');
                    console.log(error);
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                    $("#ctdImageContainer").attr('src', '');
                    $('#downloadsError').append('<p>No data returned to plot.</p>');
                },
                success: function (data) {
                    //console.log(data);
                    if (getNetCDFOutput === "true") {
                        //console.log('Trying to export netCDF file after success...');
                        // Export netCDF files to zip file
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = selectedStationId + '.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function () {
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    } else if (updateMap === "true") {
                        // console.log'hitting updateMap')
                        // console.log(data);
                        if (data.length > 0) {
                            generatePhotoQueryLayer(data, 'true');
                        }
                    } else if (onlyGetStationIds === "true") {
                        //console.log('get_photos');
                        //console.log(data);

                        let excludedFields = ['ObjectID', 'FileName', 'FilePath', 'ContractorID', 'ContractStatus', 'ContractNum', 'Category', 'DOI'];

                        $('#photoListing').empty();
                        $('#photoGallery').empty();

                        $('#selectSample').empty();
                        $('#selectSample')
                            .append($("<option></option>")
                                .attr("value","SelectSampleID")
                                .prop("disabled",true)
                                .prop("selected",true)
                                .text("Select Sample ID"));
                        $('#selectSample')
                            .append($("<option></option>")
                                .attr("value","*")
                                .text("All Sample Photos"));

                        $('#selectSampleImagePageNumber').empty();
                        $('#selectSampleImagePageNumber')
                            .append($("<option></option>")
                                .attr("value","Page Number")
                                .prop("disabled",true)
                                .text("Select Page Number"));

                        $('#selectSampleImagePageNumber')
                            .append($("<option></option>")
                                .attr("value",".sample-"+1)
                                .prop("selected",true)
                                .text(1));

                        if (data.length > 0) {
                            let table = document.createElement('table'),
                                tbody = document.createElement('tbody'),
                                thead = document.createElement('thead');

                            table.id = "photo-table";
                            table.className = "photo-table";

                            table.appendChild(tbody);

                            let headers = [];
                            let page_number_cnt = 0;
                            let page_number = 1;
                            $.each(data, function(i, photo){
                                //console.log(i);
                                //console.log(photo);
                                tbody.insertRow(i);

                                let x = 0;
                                let pv_id = 20000;
                                let pv_name = '';
                                let pv_path = '';
                                let pv_sample_id = '';
                                let pv_station_id = '';

                                $.each(photo, function(label, field){
                                    //console.log(x);
                                    // console.log(label);
                                    // console.log(field);

                                    if (field === null)
                                        field = '';

                                    // Add the cell as long as it isn't excluded
                                    if (excludedFields.indexOf(label) === -1) {
                                        tbody.rows[i].insertCell(x);
                                        tbody.rows[i].cells[x].appendChild(
                                            document.createTextNode(field)
                                        );
                                        headers.push(label);
                                        x = x + 1;
                                    }

                                    if (label === 'ObjectID')
                                        pv_id = field;
                                    if (label === 'FileName')
                                        pv_name = field;
                                    if (label === 'FilePath')
                                        pv_path = field;
                                    if (label === 'SampleID')
                                        pv_sample_id = field;
                                    if (label === 'StationID')
                                        pv_station_id = field
                                }); // insert columns

                                // TODO: Add photo count here
                                let photoList = pv_name.split(',')
                                tbody.rows[i].insertCell(x);
                                tbody.rows[i].cells[x].appendChild(
                                    document.createTextNode(photoList.length)
                                );
                                headers.push('File Count');

                                tbody.rows[i].id = pv_id;
                                tbody.rows[i].classList.add("sample-image-tr", "sample-"+page_number, pv_id, "uid-"+i);

                                // Add all the photos
                                //if (radioValue === 'sample') {
                                openPhotoVideoDownload(i, pv_id, pv_name, pv_path.split(':\\')[1].replace(/\\/g, '\\\\'), photo, "sample-"+page_number, 'image', 'uid-'+i);
                                //} else {
                                //    openPhotoVideoDownload(i, pv_id, pv_name, pv_path.split(':\\')[1].replace(/\\/g, '\\\\'), photo, "sample-"+page_number, 'video', 'uid-'+i);
                                //}


                                $('#selectSample')
                                    .append($("<option></option>")
                                        .attr("value","."+pv_id)
                                        .text(photo['SampleID']));

                                if (page_number_cnt < 7) {
                                    page_number_cnt = page_number_cnt + 1;
                                } else {
                                    page_number = page_number + 1;
                                    if (page_number > 1) {
                                        $('#selectSampleImagePageNumber')
                                            .append($("<option></option>")
                                                .attr("value",".sample-"+page_number)
                                                .text(page_number));
                                    }
                                    page_number_cnt = 0;
                                }

                                // Add the photo download action
                                tbody.rows[i].addEventListener('click', function(){
                                    // console.log('openPhotoVideoDownload');
                                    // console.log(pv_name);
                                    // console.log(pv_path);
                                    // TODO: Make sure input values make sense
                                    //get_photos_results('true', '', 'false', 'false', pv_id, pv_station_id, pv_sample_id)
                                    openPhotoVideoDownload(i, pv_id, pv_name, pv_path.split(':\\')[1].replace(/\\/g, '\\\\'), photo, page_number, 'zip', 'uid-' + i);
                                });

                                tbody.rows[i].addEventListener('mouseover', function(event){
                                    // console.log(event);

                                    if (photoNoPos === 'true') {
                                        let latitude = parseFloat(event.srcElement.parentElement.childNodes[4].innerText);
                                        let longitude = parseFloat(event.srcElement.parentElement.childNodes[5].innerText);
                                        let zoom = 12
                                        // highlight the mouseover target
                                        zoomPoint.latitude = latitude;
                                        zoomPoint.longitude = longitude;

                                        let esri_goto_option = {
                                            animate: true,
                                            duration: 200,
                                        };

                                        view.goTo({
                                            target: zoomPoint,
                                            zoom: zoom

                                        }, esri_goto_option).catch(function (error) {
                                            if (error.name !== "AbortError") {
                                                console.error('zoom to real location, view goto error', error);
                                            }
                                        });
                                    }

                                    $(event.composedPath()[1]).addClass('photo-table-row-hover');

                                    // TODO: Need the current page
                                    //console.log("#img-sample-uid-" + i);
                                    //$grid.isotope({ filter: ".uid-" + i })

                                    $("#img-sample-uid-" + i).removeClass('photo-gallery-highlight-off');
                                    $("#img-sample-uid-" + i).addClass('photo-gallery-highlight');
                                });

                                tbody.rows[i].addEventListener('mouseout', function(event){
                                    // console.log(event.target);
                                    // highlight the mouseover target
                                    $(event.composedPath()[1]).removeClass('photo-table-row-hover');
                                    let cpagenum = $('#selectSampleImagePageNumber').val();
                                    //console.log(cpagenum);
                                    //$grid.isotope({ filter: cpagenum });

                                    $("#img-sample-uid-" + i).removeClass('photo-gallery-highlight');
                                    $("#img-sample-uid-" + i).addClass('photo-gallery-highlight-off');
                                });
                                //tbody.rows[i].onclick = "openExternalDownload('" + pv_id + "','" + pv_name + "','" + pv_path.split(':\\')[1].replace(/\\/g, '\\\\') + "');";
                            }); // insert rows

                            // insert headers
                            table.appendChild(thead);
                            thead.insertRow(0);
                            //console.log(headers);
                            headers = _.uniq(headers);
                            //console.log(headers);
                            $.each(headers, function(k, header){
                                thead.rows[0].insertCell(k);
                                thead.rows[0].cells[k].appendChild(
                                    document.createTextNode(header)
                                );
                            });

                            // insert table caption
                            table.createCaption();
                            table.caption.appendChild(
                                document.createTextNode('Sample Level')
                            );

                            $('#photoListing').append(table);
                        } else {
                            let table = document.createElement('table'),
                                tbody = document.createElement('tbody'),
                                thead = document.createElement('thead');

                            table.id = "photo-table";
                            table.className = "photo-table";

                            table.appendChild(tbody);

                            // insert headers
                            table.appendChild(thead);
                            thead.insertRow(0);
                            let headers = ['Contractor','Mineral Type','ConfStatus','Cruise_Leg','StationID','SampleID'];

                            $.each(headers, function(k, header){
                                thead.rows[0].insertCell(k);
                                thead.rows[0].cells[k].appendChild(
                                    document.createTextNode(header)
                                );
                            });

                            // insert table caption
                            table.createCaption();
                            table.caption.appendChild(
                                document.createTextNode('Sample Level (No Data)')
                            );
                            $('#photoListing').append(table)
                        }

                        //$grid.isotope('layout');

                        //populateStations(data['stations']);
                        // populateStationParameters(data['stations']['plot_parameters']);
                        $grid.isotope('updateSortData').isotope();
                        $('#selectSampleImagePageNumber').val('.sample-1').change();
                        if (forceReload === 'true') {
                            //console.log('forcing photo layer reload');
                            if (radioValue === 'sample') {
                                //queryPointsLayerPhotos(data)
                            } else {
                                //queryLinesLayerPhotos(data);
                            }
                        }
                        return data

                    } else {
                        //let camera = document.getElementById('ctdImageContainer');
                        //let camera = $("#ctdImageContainer");
                        //camera.attr("src", 'data:image/png;base64,'+ btoa(data));
                        //let url = window.URL || window.webkitURL;
                        //img.src = url.createObjectURL(data);
                        //$("#ctdImageContainer").html('<img src="' + data + '" />');
                        $("#ctdImageContainer").attr('src', '');
                        let img = document.getElementById('ctdImageContainer');
                        let the_a = document.getElementById('ctdImageLink');
                        let url = window.URL || window.webkitURL;
                        img.src = url.createObjectURL(data);
                        the_a.href = url.createObjectURL(data);
                        the_a.download = selectedStationId;
                    }

                },
                error: function (request, status, error) {
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                    $("#ctdImageContainer").attr('src', '');
                    $('#downloadsError').append('<p>No data returned to plot.</p>');
                    console.log(request.responseText);
                    console.log(status);
                    console.log(error);
                }
            })).done(function(data, textStatus, jqXHR){
                $("#processing-spinner").hide();
                $("#tabs").removeClass('disabledButton');
                zoomToPhotoLayer(updateMap);
                return data
            });

            if (updateMap === 'true') {
                get_photos_results('true', '', 'false', 'false', 0, '', '', 'true')
            } else {
                get_photos_results('true', selectedStationId, 'false', 'false', 0, '', '', 'false')
            }

        }

        // Get Photos and Videos
        function get_photos_results(onlyGetStationIds, selectedStationId, getNetCDFOutput, forceReload, objectId, stationId, sampleId, updateMap){

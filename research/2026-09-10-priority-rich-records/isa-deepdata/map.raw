                        $("#tabs").addClass('disabledButton');
                    },
                    success: function (data) {
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = 'biology_points_lines_pivot_export.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function(){
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    },
                    error: function (error) {
                        console.log('There was an error running openExternalDownload: ' + error);
                        $("#processing-spinner").hide();
                        $("#tabs").removeClass('disabledButton');
                    }
                })).done(function(data, textStatus, jqXHR){
                    // console.log('done with mssql_get_tblBiologyPivot');
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }
        }

        function updateFiltersFromJson(data){
            $("#processing-spinner").show();
            $("#tabs").addClass('disabledButton');

            // console.log('updateFiltersFromJson');
            // console.log(data);

            // Contractors
            $("[id^=contractor]:not([id$=\"ALL\"])").removeClass('fa-toggle-on');
            $("[id^=contractor]:not([id$=\"ALL\"])").addClass('fa-toggle-off');
            if(data.contractors.length === 0){
                $("[id^=contractor][id$=\"ALL\"]").removeClass('fa-toggle-on');
                $("[id^=contractor][id$=\"ALL\"]").addClass('fa-toggle-off');
            }
            if(data.contractors.length === $("[id^=contractor]:not([id$=\"ALL\"])").length){
                $("[id^=contractor][id$=\"ALL\"]").removeClass('fa-toggle-off');
                $("[id^=contractor][id$=\"ALL\"]").addClass('fa-toggle-on');
            }else{
                $("[id^=contractor][id$=\"ALL\"]").removeClass('fa-toggle-on');
                $("[id^=contractor][id$=\"ALL\"]").addClass('fa-toggle-off');
            }
            $.each(data.contractors, function(key, data) {
                let item = data;
                // console.log("[id^=contractors-"+item.ContractorID+"]");
                $("[id^=contractor-"+item.ContractorID+"]").removeClass("fa-toggle-off");
                $("[id^=contractor-"+item.ContractorID+"]").addClass("fa-toggle-on");

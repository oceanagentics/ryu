                            caption : theCaption,
                            altRows: false,
                            ignoreCase: true,
                            shrinkToFit : false,
                            multiselect: false,
                            multiboxonly: false,
                            reloadAfterSubmit : false,
                            loadOnce : true,
                            hidegrid : false,
                            loadComplete: function(){
                                if($("#jqGridSearchBioL").jqGrid('getGridParam', 'records'))
                                    theCaption = "Biological Records - (Showing " + $("#jqGridSearchBioL").jqGrid('getGridParam', 'records') + " records out of " + theCount + " total records)";
                                $("#jqGridSearchBioL").jqGrid('setCaption', theCaption);
                            },
                            gridComplete: function(){
                                $("#processing-spinner").hide();
                                $("#tabs").removeClass('disabledButton');
                            }
                        }).jqGrid('navGrid',
                            '#jqGridPagerSearchBioL',
                            {
                                edit : false,
                                add : false,
                                del : false,
                                refresh : false,
                                search : true
                            },
                            {},
                            {},
                            {},
                            {
                                
                                closeOnEscape : true,
                                multipleSearch : true,
                                multipleGroup : true,
                                
                                width : 700,
                                recreateForm:true,
                                jqModal:true

                            });

                        $("#jqGridSearchBioL").jqGrid('filterToolbar', { stringResult: true, searchOperators: true, searchOnEnter: false, defaultSearch: "cn" });

                        $("#jqGridSearchBioL").jqGrid('navButtonAdd', '#jqGridPagerSearchBioL', {
                            caption: "Column Changer",
                            buttonicon: "ui-icon-calculator",
                            title: "Column Changer",
                            onClose: function () {
                                $("#mainNavToggler").click();
                            },
                            onClickButton: function () {
                                $("#mainNavToggler").click();
                                $(this).jqGrid('columnChooser',{
                                    width: 700,
                                    dialog_opts: {
                                        modal: true,
                                        minWidth: 470,
                                        
                                        show: 'blind',
                                        hide: 'explode',
                                        dividerLocation: 0.5
                                    }
                                });
                                $("#colchooser_" + $.jgrid.jqID(this.id) + " ul.selected")
                                    .bind("sortreceive", function (event, ui) {
                                        // alert('column "' + ui.item.text() + '" is chosen');
                                    });
                                $("#colchooser_" + $.jgrid.jqID(this.id) + " ul.available a.action")
                                    .click(function () {
                                        // alert('column "' + $(this).parent().text() + '" is chosen');
                                    });

                            }
                        });
                    });
                });
            }
        }

        // MSSQL Get tblBiology
        function mssql_get_tblBiologyPivot2(doExport, sampleType, searchByApeiOnly){
            //console.log('Fetching BiologyPivot Query');

            let biologicalCategory = $('#selectBiologicalCategory').val();
            let apei = $('#selectApei-Biological').val();
            //console.log(biologicalCategory);

            let exportFormat = '';
            if(doExport){
                exportFormat = 'csv'
            }

            let theCaption = "Biological Records Pivot";
            let queryData = get_queryData(biologicalCategory, exportFormat, 0, sampleType, apei, searchByApeiOnly);
            //queryData['searchByApeiOnly'] = searchByApeiOnly;
            // console.log(queryData);

            if(doExport){
                // console.log('pivot query doExport');
                $.when($.ajax({
                    statusCode: {
                        500: function(err) {
                            // alert("error");
                            // console.log('There was an error running data download zip file');
                            // console.log(err);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                        }
                    },
                    url: 'mssql_get_tbl_bio_pivot',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'document',
                    type: 'POST',
                    contentType: "application/json",
                    data: queryData,
                    xhrFields:{
                        responseType: 'blob'
                    },
                    beforeSend: function (xxx) {
                        $("#processing-spinner").show();
                        $("#tabs").addClass('disabledButton');
                    },
                    success: function (data) {
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = 'biology_' + sampleType + '_pivot_export.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function(){
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    },
                    error: function (error) {
                        console.log('There was an error running openExternalDownload: ' + error);
                        $("#processing-spinner").hide();
                        $("#tabs").removeClass('disabledButton');
                    }
                })).done(function(data, textStatus, jqXHR){
                    // console.log('done with mssql_get_tblBiologyPivot');
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }
        }

        // MSSQL Get tblBiology combined point and lines
        function mssql_get_tblBiologyPivotCombined(doExport, sampleType, searchByApeiOnly){
            console.log('Fetching BiologyPivot Combined Query');

            let biologicalCategory = $('#selectBiologicalCategory').val();
            let apei = $('#selectApei-Biological').val();

        function populateUnderseaFeatures(data) {
            $('#selectUnderseaFeature').empty();
            $('#selectUnderseaFeature')
                .append($("<option></option>")
                    .attr("value","selectUnderseaFeature")
                    .prop("disabled",true)
                    .prop("selected",false)
                    .text("Select Undersea Feature"));
            $.each(data.features, function(key, val){
                // console.log(key);
                // console.log(val);
                $('#selectUnderseaFeature')
                    .append($("<option></option>")
                        .attr("value",[parseFloat(val.attributes.CENT_LONG),parseFloat(val.attributes.CENT_LAT)])
                        .text(val.attributes.UF_NAME));
            });

            let options = $("#selectUnderseaFeature option");   // Collect options
            options.detach().sort(function(a,b) {               // Detach from select, then Sort
                let at = $(a).text();
                let bt = $(b).text();
                return (at > bt)?1:((at < bt)?-1:-1);            // Tell the sort function how to order
            });
            options.appendTo("#selectUnderseaFeature");         // Re-attach to select
        }


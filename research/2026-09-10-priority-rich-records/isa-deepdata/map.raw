        let toggleLayerHandler = function(event){
            let theToggle = $($(event)[0].target);
            // console.log('theToggle');
            // console.log(theToggle);

            let filterType = theToggle[0].id.split('-')[0];
            // console.log('filterType');
            // console.log(filterType);

            if (theToggle[0].id.indexOf(filterType) === 0) {
                // console.log('Clicked on a ' + filterType + ' Layer Filter with an ID of: ' + theToggle[0].id.split("-")[1]);

                // TODO: Check if ANY are toggled off, then toggle off the ALL without action
                let specificToggle = $("[id^=" + filterType + "]");
                if (theToggle.hasClass('fa-toggle-on')) {
                    if (theToggle[0].id.split("-")[1] === 'ALL' || theToggle[0].title === 'ALL') {
                        specificToggle.removeClass("fa-toggle-on");
                        specificToggle.addClass("fa-toggle-off");
                    } else {
                        theToggle.removeClass("fa-toggle-on");
                        theToggle.addClass("fa-toggle-off");
                    }
                } else {
                    if (theToggle[0].id.split("-")[1] === 'ALL' || theToggle[0].title === 'ALL') {
                        specificToggle.removeClass("fa-toggle-off");
                        specificToggle.addClass("fa-toggle-on");
                    } else {
                        theToggle.removeClass("fa-toggle-off");
                        theToggle.addClass("fa-toggle-on");
                    }
                }
            }
        };

        function toggle_map_data_divs(page) {
            if(page === "map"){
                document.getElementById("viewDiv").style.display = "inherit";
                document.getElementById("dataDiv").style.display = "none";
            }else{
                document.getElementById("viewDiv").style.display = "none";
                document.getElementById("dataDiv").style.display = "inherit";
            }
        }


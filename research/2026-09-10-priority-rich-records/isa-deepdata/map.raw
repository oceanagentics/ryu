        function assignClickActions() {
            // Action to take when a toggle is clicked
            $('[id^=contractor]').click(function (event) {
                // console.log('clicked on a contractor toggle');
                // console.log(event);
                event.stopPropagation();
                event.stopImmediatePropagation();

                toggleLayerHandler(event);
                get_tblContractors('contractor');
            });

            // Contract Status
            $('[id^=contractStatus]').click(function (event) {
                // console.log('clicked on a contractStatus toggle');
                // console.log(event);
                event.stopPropagation();
                event.stopImmediatePropagation();

                toggleLayerHandler(event);
                get_tblContractors('contractStatus');
            });

            // Sponsoring State
            $('[id^=sponsoringState]').click(function (event) {
                // console.log('clicked on a sponsoringState toggle');
                // console.log(event);
                event.stopPropagation();
                event.stopImmediatePropagation();

                toggleLayerHandler(event);
                get_tblContractors('sponsoringState');
            });

            // Mineral Types
            $('[id^=mineralTypes]').click(function (event) {
                // console.log('clicked on a mineralTypes toggle');
                // console.log(event);
                event.stopPropagation();
                event.stopImmediatePropagation();

                toggleLayerHandler(event);
                get_tblContractors('mineralTypes');
            });

            // Locations
            $('[id^=locations]').click(function (event) {
                // console.log('clicked on a locations toggle');
                // console.log(event);
                event.stopPropagation();
                event.stopImmediatePropagation();

                toggleLayerHandler(event);
                get_tblContractors('locations');
            });

            $("#selectTheme").on('change', function(e){
                //console.log(e);
                $("#processing-spinner").show();
                $("#tabs").addClass('disabledButton');
                let selectTheme = $('#selectTheme').val();
                if(selectTheme === 'Photo_Video'){
                    mssql_get_tblLibrary(false, true);
                }else{
                    mssql_get_tblLibrary(false, false);
                }
            });

            $('input[name=samplevstrawl]').on('change', function (e) {
                get_photos('true', '', 'false', 'true', 'false');
            });

            $('input[name=photonopos]').on('change', function (e) {
                get_photos('true', '', 'false', 'true', 'false');
            });

            $('input[name=lineorscatter]').on('change', function (e) {
                let stationId = $('#selectStation').val();
                get_stations("false", stationId, "false", "false", "true", "false", "false", "false", "false", 'true');
            });
        }

        let alreadyCreatedFiltersFromJson = false;

        // Get tblContractors
        function get_tblContractors(method){

            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();
            // console.log('locationIds');
            // console.log(locationIds);

            let noSelection = false;
            if(contractorIds.length === 0 && alreadyCreatedFiltersFromJson)
                noSelection = true;

            let queryData = {'Method': method, 'NoSelection': noSelection, 'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds, 'APEI': []};

            $.when($.ajax({
                url: 'get_tblContractors/',
                timeout: 600000,
                ajax: true,
                responseType: 'json',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify(queryData),
                beforeSend: function(xxx) {
                    $("#processing-spinner").show();
                    $("#tabs").addClass('disabledButton');
                },
                success: function (data) {
                    //console.log('kjashdkjhasdfkjhgkdfjhgkjsdfhgkjhdfkgjdfkjh');
                    //console.log(data);
                    //console.log(data);
                    
                    
                    

                    if(alreadyCreatedFiltersFromJson){
                        updateFiltersFromJson(data);
                        get_photos('true', '', 'false', 'true', 'false');
                    }else{
                        createFiltersFromJson(data);
                        get_photos('true', '', 'false', 'true', 'true');
                    }

                }
            })).done(function(data, textStatus, jqXHR){
                assignClickActions();
                if(method !== 'initial-render')
                    layerFilterMapHandler('','');
                $("#processing-spinner").hide();
                $("#tabs").removeClass('disabledButton');
                return data
            });
        }

        function downloadCSV(filename, csv) {
            let data, link;

            if (csv == null) return;


            if (!csv.match(/^data:text\/csv/i)) {
                csv = 'data:text/csv;charset=utf-8,' + csv;
            }
            data = encodeURI(csv);

            link = document.createElement('a');
            link.setAttribute('href', data);
            link.setAttribute('download', filename);
            link.click();
        }

        function consume(reader) {
            let total = 0;
            return pump();
            function pump() {
                return reader.read().then(({done, value}) => {
                    if (done) {
                        return
                    }
                    total += value.byteLength;
                    //console.log(`received ${value.byteLength} bytes (${total} bytes in total)`);
                    return pump()
                })
            }
        }

        // Find all the toggled-on contractors
        function get_layers_contractors_ids() {
            return $("[id^=contractor]").map(function() {
                if($(this).attr('class') === "filter-toggle filter-toggle fa fa-toggle-on" && $(this).attr('title') !== "ALL"){
                    return $(this).attr('id').split("contractor-")[1];
                }
            }).get();
        }


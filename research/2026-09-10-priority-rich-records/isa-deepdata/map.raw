            //let queryData = {'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds, "Theme": "", "ExportFormat": null, "StationIds": [selectedStationId], "OnlyStationIds": onlyGetStationIds, "AllStationIds": "false", "Parameters": ["Temperature cast"], "netCDFOutput": netCDFOutput, "ParameterStationIds": ""};


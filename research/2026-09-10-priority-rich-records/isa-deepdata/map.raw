        <div id="tabs-10" class="mainSidebar" style="font-size: small;">
            <span class="h4">Docs</span>
            <br><br>
            <p>
                <span class="h5"><a href="/static/tools/UserManual_v1.1_20181119.pdf" target="_blank" style="background-color: lightskyblue; padding: 5px; border-radius: 10px;border: black; border-width: 2px;">User Manual</a></span>
                <br>
                <span style="font-style: italic; font-size: 14px;">DeepData has been under development since this document was published, so there may be certain elements of the User Manual that are not current.  The User Manual will be updated and re-posted in the near future.</span>
            </p>
            <br><br>
            <!--<p><span class="h5"><a href="/static/tools/Biological_DataType_Convert_20190724.xlsm" style="background-color: lightskyblue; padding: 5px; border-radius: 10px;border: black; border-width: 2px;">Biological Data Type Conversion Tool (Excel)</a></span></p>
            <span class="h6">This tool will convert the biological data exports to a cross-tab format.  Instructions for use:</span>
            <ol>
                <li>Download the Biological_DataType_Convert_yyyymmdd.xlsm file to your local hard drive.</li>
                <li>Open the Biological_DataType_Convert_yyyymmdd.xlsm file.</li>
                <li>Click the “Import CSV” button and navigate to the biological export file  you wish to convert:  biology_lines_data_export.csv or biology_points_data_export.csv.</li>
                <li>Click the “Cross Tab Format” button.</li>
                <li>The converted results are included in the ‘Biological_Data_Crosstab’ worksheet.</li>
            </ol>-->
            <p><span class="h5"><a href="/static/tools/Search Result Dictionary.xlsx" style="background-color: lightskyblue; padding: 5px; border-radius: 10px;border: black; border-width: 2px;">Search Result Dictionary</a></span></p>
            <br><br>
            <p><span class="h5"><a href="/static/tools/DeepData File Catalogue Q2 2019.xlsx" style="background-color: lightskyblue; padding: 5px; border-radius: 10px;border: black; border-width: 2px;">Currently Loaded Data Library</a></span></p>
        </div>
        <div id="tabs-5" class="mainSidebar" style="font-size: small;">
            <div>
                <span class="h4">Media Gallery</span>
            </div>
        </div>
        
    </div>
</div>

<!-- Map View -->
<div id="viewDiv"></div>



<div id="info">
    <span id="ContractID"></span><br>
    <span id="blockID_Orig"></span>
</div>


<div id="footerDiv" class="navbar-fixed-bottom">
    <span style="text-transform: uppercase; font-size: 12px; font-weight: 100;" class="fa fa-copyright">2023 International Seabed Authority</span>
</div>

<!-- Login Dialog -->
<div id="loginView" style="display: none;align-items: center;">
    <div style="top: -50px; right: 5px; float: right; position: relative; font-size: large;">
        <span class="fa fa-close" aria-hidden="true" onclick="onClickLoginExit()"></span>
    </div>
    <div>
        <span class="fa fa-user" aria-hidden="true" style="float: top; font-size: large; padding-bottom: 20px;"> Login</span>
        <form id="loginForm" onsubmit="loginOnSubmit()" method="post">
            <span id="login-username" style="font-weight: 200; padding: 15px;">Email Address<input title="username" type="email"></span>
            <p></p>
            <span id="login-password" style="font-weight: 200; padding: 15px;">Password<input title="password" type="password"></span>
            <p></p>
        </form>
        <button type="submit" form="loginForm" value="Submit">Submit</button>
    </div>
</div>

<!-- Filter Info Dialog -->
<div id="filterInfoDialog" class="ui-widget-content" style="align-items: center; display: none;">
    <div style="top: -50px; right: 5px; float: right; position: relative; font-size: large;">
        <span class="fa fa-close" aria-hidden="true" onclick="onClickInfoDialogExit()"></span>
    </div>
    <div>
        <span class="fa fa-info-circle" aria-hidden="true" style="float: top; font-size: large; padding-bottom: 20px; color: blue;"> Filter Info</span>

    </div>
</div>


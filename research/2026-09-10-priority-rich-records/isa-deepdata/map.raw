                        function zoomToLayer(layer) {
                            // console.log('layer');
                            // console.log(layer);
                            if (layer !== undefined) {
                                return layer.queryExtent().then((response) => {
                                    // console.log('response');
                                    // console.log(response);
                                    if (response.extent !== null) {
                                        view.goTo(response.extent).catch((error) => {
                                            console.error(error);
                                        });
                                    }
                                });
                            }
                        }


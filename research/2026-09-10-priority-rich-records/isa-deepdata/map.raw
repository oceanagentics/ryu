            const delay = ms => new Promise(res => setTimeout(res, ms));

            const checkLayersLoaded = async () => {
                let stillLoading = true;

                displayMessage("<br><span>Start checking if layers are done loading." + '</span>');
                //console.log(view.map.layers.items);
                while (stillLoading) {
                    await delay(3000);
                    let layerCount = view.map.layers.length;
                    displayMessage('<br><span>layerCount: ' + layerCount + '</span>');


                    $.each(view.map.layers.items, function(key, layer){
                        //console.log("Waited an additional 5s");
                        displayMessage('<br><span>loadStatus: ' + layer.loadStatus + '</span>');
                        if (layer.loadStatus === 'loaded')
                            layerCount = layerCount - 1;
                    });

                    displayMessage('<br><span>layerCount: ' + layerCount + '</span>');

                    if (layerCount === 0) {
                        stillLoading = false;
                        displayMessage("<br><span>Done loading layers." + '</span>');
                    }
                }
            };


            


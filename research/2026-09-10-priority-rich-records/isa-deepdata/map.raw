        let openExternalDownload = function(id,name,path){
            $("#processing-spinner").show();
            $("#tabs").addClass('disabledButton');
            // console.log('openExternalDownload');
            // console.log(path);
            //alert('Download of file '+name+' ('+id+')'+' is not available at this time.');
            let file_path = path+'\\'+name;
            $('#downloadsError').empty();
            // console.log(file_path);
            let queryData = {'name': name, 'path': path, 'APEI': []};
            $.when($.ajax({
                statusCode: {
                    500: function() {
                        // alert("error");
                        console.log('There was an error running openExternalDownload');
                        //console.log(error);
                        $('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                    }
                },
                url: 'dar',
                timeout: 600000,
                ajax: true,
                responseType: 'document',
                type: 'POST',
                contentType: "application/json",
                data: JSON.stringify(queryData),
                xhrFields:{
                    responseType: 'blob'
                },
                success: function (data) {
                    let anchor = document.createElement('a');
                    let url = window.URL || window.webkitURL;
                    anchor.href = url.createObjectURL(data);
                    anchor.download = name+'.zip';
                    document.body.append(anchor);
                    anchor.click();
                    setTimeout(function(){
                        document.body.removeChild(anchor);
                        url.revokeObjectURL(anchor.href);
                    }, 5);
                },
                error: function(xhr, status, error) {
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                    let acc = [];
                    $.each(xhr, function(index, value) {

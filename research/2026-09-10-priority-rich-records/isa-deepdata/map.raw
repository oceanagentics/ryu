                        highlightCTDSelection = function(selectedObjectID, cruiseLeg, contractorId) {
                            // Add the query results to the Selected CTD Station Location
                            let queryRemoveAll = new Query();
                            queryRemoveAll.outputGeometry = true;
                            queryRemoveAll.outFields = ["*"];
                            queryRemoveAll.where = "1 = 1";
                            queryRemoveAll.returnGeometry = true;
                            queryCTDPointsResultsLayer3.queryFeatures(queryRemoveAll).then(function(results){
                                // console.log('whenLayerView completed');
                                // console.log(results);
                                queryCTDPointsResultsLayer3.applyEdits({deleteFeatures: results.features});
                            })

                            queryCTDPointsResultsLayer.visible = false;
                            queryCTDPointsResultsLayer3.visible = true;

                            let query = new Query();
                            query.outputGeometry = true;
                            query.outFields = ["*"];
                            if (selectedObjectID === undefined)
                                selectedObjectID = 1;
                            query.where = "StationID = '" + selectedObjectID + "' AND Cruise_Leg = '" + cruiseLeg + "' AND ContractorID = '" + contractorId + "'" ;
                            query.returnGeometry = true;
                            // console.log(query.where);

                            // Add the query results to the Selected CTD Station Location
                            queryCTDPointsResultsLayer.queryFeatures(query).then(function(results){
                                // console.log('whenLayerView completed');
                                // console.log(results);
                                queryCTDPointsResultsLayer3.applyEdits({addFeatures: results.features});
                            })
                        }

                        function zoomToLatLong(__lat, __long, __zoom) {
                            // bug fix https://community.esri.com/thread/224073-how-to-use-viewgoto
                            // https://developers.arcgis.com/javascript/latest/api-reference/esri-views-MapView.html#goTo
                            let esri_point = new Point({
                                latitude: __lat,
                                longitude: __long
                            });

                            let esri_goto_option = {
                                animate: true,
                                duration: 200,
                            };

                            view.goTo({
                                target: esri_point,
                                zoom: __zoom

                            }, esri_goto_option).catch(function (error) {
                                if (error.name !== "AbortError") {
                                    console.error('zoom to real location, view goto error', error);
                                }
                            });
                        }

                        $("#selectUnderseaFeature").on('change', function(e){
                            //console.log(e);
                            let pos = $('#selectUnderseaFeature').val();
                            //console.log(pos);
                            let pos_split = pos.split(',');
                            let lon = parseFloat(pos_split[0]);
                            let lat = parseFloat(pos_split[1]);
                            zoomToLatLong(lat, lon, 8);
                        });

                        const targetNode = document.getElementById('ctdCurrentStation');

                        // Options for the observer (which mutations to observe)
                        const config = { attributes: true, childList: true, subtree: true };

                        // Callback function to execute when mutations are observed
                        const callback = (mutationList, observer) => {
                            for (const mutation of mutationList) {
                                if (mutation.type === 'childList') {
                                    // console.log('A child node has been added or removed.');
                                    // console.log(mutation.data);
                                } else if (mutation.type === 'attributes') {
                                    // console.log(`The ${mutation.attributeName} attribute was modified.`);
                                    let pos = targetNode.getAttribute('data-lonlat');
                                    // console.log(pos);
                                    let pos_split = pos.split(',');
                                    let lon = parseFloat(pos_split[0]);
                                    let lat = parseFloat(pos_split[1]);
                                    //console.log(['lat, lon, 8']);
                                    if (mutation.attributeName === 'data-lonlat' || mutation.attributeName === 'data-refresh'){
                                        zoomToLatLong(lat, lon, 12);
                                    }
                                    if (mutation.attributeName === 'data-stationid') {
                                        highlightCTDSelection(targetNode.getAttribute('data-stationid'), targetNode.getAttribute('data-cruiseleg'), targetNode.getAttribute('data-contractorid'));
                                    }
                                }
                            }
                        };

                        // Create an observer instance linked to the callback function
                        const observer = new MutationObserver(callback);

                        // Start observing the target node for configured mutations
                        observer.observe(targetNode, config);

                        


                        generatePhotoQueryLayer = function(data, homePage) {
                            $("#processing-spinner").show();
                            $("#tabs").addClass('disabledButton');
                            let t = [
                                {
                                    "ObjectID": 14629,
                                    "Contractor": "Institut français de recherche pour l'exploitation de la mer - PMN",
                                    "ContractorID": "IFREMER1",
                                    "Mineral Type": "PMN",
                                    "ContractNum": 1,
                                    "ContractStatus": "Active",
                                    "ConfStatus": "Public",
                                    "Cruise_Leg": "SO239_1",
                                    "Latitude": "11.038",
                                    "Longitude": "-119.6815",
                                    "StationID": "99",
                                    "SampleID": "SO239_11",
                                    "FileName": "VidTrack1_211.mp4",
                                    "FilePath": "M:\\Archived\\IFREMERPMN12018",
                                    "DOI": null
                                }
                            ]
                            // JDC console.log('generatePhotoQueryLayer');
                            // console.log(data);

                            // create an array of graphics based on the data above
                            let graphics = [];

                            for (let i = 0; i < data.length; i++) {
                                if (data[i].Latitude !== null && data[i].Longitude !== null){
                                    let graphic = new Graphic({
                                        geometry: {
                                            type: "point",
                                            latitude: parseFloat(data[i].Latitude),
                                            longitude: parseFloat(data[i].Longitude)
                                        },
                                        attributes: data[i]
                                    })
                                    graphics.push(graphic);
                                }
                            }

                            queryPhotoPointsResultsLayer3.applyEdits({addFeatures: graphics});

                            if (homePage !== 'true') {
                                queryPhotoPointsResultsLayer3.visible = true;
                                zoomToLayer(queryPhotoPointsResultsLayer3);
                            }

                            //zoomToLatLong(parseFloat(data[0]['Latitude']), parseFloat(data[0]['Longitude']), 8)
                            $("#processing-spinner").hide();
                            $("#tabs").removeClass('disabledButton');
                        }


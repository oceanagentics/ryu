                                    // TODO: DEAL WITH COMMA SEPARATED VALUES
                                    openPhotoVideoResultsDownload(i, pv_id, pv_name, pv_path.split(':\\')[1].replace(/\\/g, '\\\\'), photo, page_number, 'zip', 'uid-' + i);
                                });


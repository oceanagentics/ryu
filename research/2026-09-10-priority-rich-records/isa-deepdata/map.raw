                    +item.AreaSector+
                    '</span>'+
                    '</div>'
                );
            });
            items.push('</div>');

            $( "<div/>", {
                "class": "map-filters-level-0",
                "id": "accordionDiv2",
                html: items.join( "" )
            }).appendTo( "#accordionLayers" );

            alreadyCreatedFiltersFromJson = true;
            //layerFilterMaphandler();
            $("#processing-spinner").hide();
            $("#tabs").removeClass('disabledButton');
        }

        // ****************************************************************************************
        // Document Ready Functions

        $(document).ready(function(){
            // Impose modal for data usage acceptance
            if (Cookies.get('beta') == null) {
                $('#myModal').modal({backdrop: 'static', keyboard: 'false', 'show': true});
                Cookies.set('beta', '1');
            }

            // Set up the side bar navigation tabs
            $("#tabs").tabs();
            // console.log(window.location.hash.substring(1));
            if(window.location.hash.substring(1) !== ""){
                w3_open();
                $('a[href="'+window.location.hash+'"]').click();
            }

            let searchByApeiOnly = false;

            $("[id^=tabs-]").mouseenter(function(event){
                //console.log(event);
                let contextMessageHtml = document.getElementById("contextMessages");
                if (event.currentTarget.dataset.text !== undefined){
                    contextMessageHtml.innerHTML = event.currentTarget.dataset.text;
                }
            });

            $("[id^=tabs-]").mouseleave(function(event){
                //console.log(event);
                let contextMessageHtml = document.getElementById("contextMessages");
                contextMessageHtml.innerHTML = "";
            });

            //let tabs1target = document.getElementById("tabs-1");
            //tabs1target.addEventListener('mouseover', function(event){
            //    console.log(event);
            // highlight the mouseover target
            //$(event.path[1]).addClass('photo-table-row-hover');
            //    let contextMessageHtml = document.getElementById("contextMessages");
            //    contextMessageHtml.innerHTML = "Test message";
            //});

            

            //$("#accordionDiv1").accordion();
            $("#accordionLayers").accordion();

            $("#RunGeochemicalQuery").click(function(e){
                e.preventDefault();
                // console.log('clicked run geochem query');
                // console.log('using user name:id of:');
                mssql_get_tblContracts(false, searchByApeiOnly);
                //layerFilterMapHandler('geochemical', '');
            });

            $("#RunGeochemicalQueryExport").click(function(e){
                e.preventDefault();
                // console.log('clicked run geochem query export');
                // console.log('using user name:id of:');
                mssql_get_tblContracts(true, searchByApeiOnly);

            });

            $("#ResetCTDSearch").click(function(e){
                clearCtd();
                get_initial_ctd_data();
            })

            $("#ResetSearch").click(function(e){
                e.preventDefault();
                get_tbl_biop_analysis();
                get_habitat_types();
                get_matrix_types('Environmental Chemistry');
                get_geochemical_categories();
                get_apei_lookup();
                $('#selectDiscipline').prop('selectedIndex', 0);
                $("#selectHabitatDiv").hide();
                $("#selectMatrixDiv").hide();
                $('#biologicalQuerySelection').hide();
                $('#geochemicalQuerySelection').hide();
                $("#BioGridL").hide();
                $("#BioGridL").empty();
                $("#BioGridP").hide();
                $("#BioGridP").empty();
                $("#GeoGrid").hide();
                $("#GeoGrid").empty();

                let toggleGeo = $('#filterByAPeiIdGeochemical');
                toggleGeo.addClass("fa-toggle-off");
                toggleGeo.removeClass("fa-toggle-on");

                let toggleBio = $('#filterByAPeiIdBiological');
                toggleBio.addClass("fa-toggle-off");
                toggleBio.removeClass("fa-toggle-on");

                $('#filterByApeiIdGeochemicalDiv').hide();
                $('#filterByApeiIdBiologicalDiv').hide();
                searchByApeiOnly = false;
            });

            $("#RunBiologicalQuery").click(function(e){
                e.preventDefault();
                // console.log('clicked run biological query');
                // console.log('using user name:id of:');
                //mssql_get_tblBiologyP(false);
                //mssql_get_tblBiologyL(false);
                mssql_get_tblBiologyCombined(false, searchByApeiOnly);
                layerFilterMapHandler('biological', '');
            });

            // RunCTDQueryExport
            $("#RunCTDQueryExport").click(function(e){
                e.preventDefault();
                let stationId = $('#selectStation').val();
                //console.log('Export StationID');
                //console.log(stationId);
                get_stations("false", stationId, "true", "false", "false", "false", "false", "false", "false", 'false')
            });

            // RunCTDRecordsExport
            $("#RunCTDRecordsExport").click(function(e){
                e.preventDefault();
                get_stations("false", "", "false", "false", "false", "false", "false", "true", "false", 'false')
            });

            $("#RunBiologicalQueryExport").click(function(e){
                e.preventDefault();
                // console.log('clicked run biological query');
                // console.log('using user name:id of:');
                // $("#processing-spinner").show();
                //mssql_get_tblBiologyP(true);
                //mssql_get_tblBiologyL(true);
                mssql_get_tblBiologyCombined(true, searchByApeiOnly);
            });

            $("#RunBiologicalPivotQueryExport").click(function(e){
                e.preventDefault();
                // console.log('clicked run biological pivot query');
                // console.log('using user name:id of:');
                //mssql_get_tblBiologyPivot(true, 'Point', searchByApeiOnly);
                //mssql_get_tblBiologyPivot(true, 'Line', searchByApeiOnly);
                mssql_get_tblBiologyPivotCombined(true, '', searchByApeiOnly);
            });

            $("#RunLibraryQueryExport").click(function(e){
                e.preventDefault();
                // console.log('clicked run library query');
                // console.log('using user name:id of:');
                let selectTheme = $('#selectTheme').val();
                if(selectTheme === 'Photo_Video'){
                    $("#processing-spinner").show();
                    mssql_get_tblLibrary(true, true);
                }else{
                    $("#processing-spinner").show();
                    mssql_get_tblLibrary(true, false);
                }
            });

            $('#filterByAPeiIdGeochemical').click(function(e){
                e.preventDefault();
                let toggle = $("#"+e.target.id);
                if (e.target.className.endsWith('off')) {
                    toggle.removeClass("fa-toggle-off");
                    toggle.addClass("fa-toggle-on");
                    $('#filterByApeiIdGeochemicalDiv').show();
                    searchByApeiOnly = true;
                } else {
                    toggle.addClass("fa-toggle-off");
                    toggle.removeClass("fa-toggle-on");
                    $('#filterByApeiIdGeochemicalDiv').hide();
                    searchByApeiOnly = false;
                }
            });

            $('#filterByAPeiIdBiological').click(function(e){
                e.preventDefault();
                let toggle = $("#"+e.target.id);
                if (e.target.className.endsWith('off')) {
                    toggle.removeClass("fa-toggle-off");
                    toggle.addClass("fa-toggle-on");
                    $('#filterByApeiIdBiologicalDiv').show();
                    searchByApeiOnly = true;
                } else {
                    toggle.addClass("fa-toggle-off");
                    toggle.removeClass("fa-toggle-on");
                    $('#filterByApeiIdBiologicalDiv').hide();
                    searchByApeiOnly = false;
                }
            });

            //get_tblContractors('initial-render');
            get_themes();
            get_undersea_features();

            //get_stations("true", "", "false");

            //$grid = $('.grid').isotope({
            //    itemSelector: ".element-item",
            //    masonry: {
            //        columnWidth: 100
            //    }
            //});

            $grid = $('#photoGallery').isotope({
                itemSelector: ".element-item",
                masonry: {
                    columnWidth: 100
                },
                transitionDuration: '0.0s',
                hiddenStyle: {
                    opacity: 0,
                },
                visibleStyle: {
                    opacity: 1,
                },
                getSortData: {
                    category: '[data-category]'
                },
                sortBy: 'category',
                sortAscending: {
                    category: true
                }
            });

            $gridResults = $('#photoGalleryResults').isotope({
                itemSelector: ".element-item",
                masonry: {
                    columnWidth: 100
                },
                transitionDuration: '0.3s',
                hiddenStyle: {
                    opacity: 0,
                },
                visibleStyle: {
                    opacity: 1,
                },
                getSortData: {
                    results: '[data-results]'
                },
                sortBy: 'results',
                sortAscending: {
                    results: true
                }
            });

            $grid.on( 'arrangeComplete',
                function( event, laidOutItems ) {
                    //console.log( 'Isotope layout completed on ' +
                    //laidOutItems.length + ' items' );
                    //console.log(laidOutItems);
                    $('#photoGallery').show();
                    $('#photoListing').show();
                    //$("#processing-spinner").hide();
                    //$("#tabs").removeClass('disabledButton');
                }
            );

            $gridResults.on( 'arrangeComplete',
                function( event, laidOutItems ) {
                    //console.log( 'Isotope layout completed on ' +
                    //laidOutItems.length + ' items' );
                    //console.log(laidOutItems);
                    $('#photoGalleryResults').show();
                    $('#photoListingResults').show();
                    //$("#processing-spinner").hide();
                    //$("#tabs").removeClass('disabledButton');
                }
            );

            $grid.imagesLoaded().progress( function() {
                $grid.isotope('layout');
            });

            $gridResults.imagesLoaded().progress( function() {
                $gridResults.isotope('layout');
            });
        });

    </script>

    <script>
        let dojoConfig = {
            has: {
                "esri-native-promise": true
            }
        };
    </script>
</head>


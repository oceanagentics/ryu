        function get_queryData(addin1, addin2, addin3, addin4, addin5, addin6){
            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();
            // console.log('locationIds');
            // console.log(locationIds);
            let queryData = {'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds};
            queryData['BiologicalCategory'] = addin1;
            queryData['ExportFormat'] = addin2;
            queryData['QueryCount'] = addin3;
            queryData['ExportSampleType'] = addin4;
            queryData['APEI'] = addin5;
            queryData['searchByApeiOnly'] = addin6;
            // console.log(queryData);
            return(JSON.stringify(queryData));
        }

        // MSSQL Get tblBiology
        function mssql_get_tblBiologyP(doExport){
            // console.log('Fetching BiologyP Query');

            let biologicalCategory = $('#selectBiologicalCategory').val();
            let apei = $('#selectApei-Biological').val();
            // console.log(biologicalCategory);

            let exportFormat = '';
            if(doExport){
                exportFormat = 'csv'
            }

            let theCaption = "Biological Records";
            let queryData = get_queryData(biologicalCategory, exportFormat, 0, '', apei);

            if(doExport){
                $.when($.ajax({
                    statusCode: {
                        500: function() {
                            // alert("error");
                            console.log('There was an error running data download zip file');
                            //console.log(error);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                        }
                    },
                    url: 'mssql_get_tbl_biop',
                    ajax: true,
                    responseType: 'document',
                    type: 'POST',
                    contentType: "application/json",
                    data: queryData,
                    xhrFields:{
                        responseType: 'blob'
                    },
                    success: function (data) {
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = 'biology_points_export.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function(){
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    },
                    error: function (error) {
                        console.log('There was an error running openExternalDownload: ' + error);
                    }
                })).done(function(data, textStatus, jqXHR){
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }else{
                let cols = 	{"Contractor": "Contractor"
                    , "ContractorID": "ContractorID"
                    , "ContractType": "Mineral Type"
                    , "ContractNum":"ContractNum"
                    , "ContractStatus": "ContractStatus"
                    , "Cruise_Leg": "Cruise_Leg"
                    , "StationID": "StationID"
                    , "TowID": "TowID"
                    , "SampleID": "SampleID"
                    , "VPFileName": "VPFileName"
                    , "Category": "Category"
                    , "OrgNum": "OrgNum"
                    , "Analysis": "Analysis"
                    , "Result": "Result"
                    , "Unit": "Unit"};

                let colModelGen = [];
                $.each(cols, function(k,v){
                    colModelGen.push({ label: v, name: k, index: k, width: 150, hidden: false })
                });

                $("#BioGridP").hide();
                $("#BioGridL").show();
                $("#GeoGrid").hide();

                let theCount = 0;
                let queryDataCount = get_queryData(biologicalCategory, exportFormat, 1, '', apei);
                $.ajax({
                    url: 'mssql_get_tbl_biop/',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'json',
                    type: 'POST',
                    contentType: "application/json",
                    data: queryDataCount,
                    success: function (data) {
                        theCount = data['query_count'];
                        //console.log('theCount');
                        //console.log(theCount);
                    },
                    failure: function (error) {
                        console.log('There was an error running the query');
                        console.log(error);
                    }
                });

                let theData = [];
                $.when($.ajax({
                    url: 'mssql_get_tbl_biop/',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'json',
                    type: 'POST',
                    contentType: "application/json",
                    data: queryData,
                    success: function (data) {
                        theData = data;
                    },
                    failure: function (error) {
                        console.log('There was an error running the query');
                        console.log(error);
                    }
                })).done(function(theData, textStatus, jqXHR){
                    $("#BioGridP").empty();
                    $("#BioGridP").append('<div id="jqGridPagerSearchBioP" class="redmond"></div>');
                    $("#BioGridP").append('<table id="jqGridSearchBioP" class="redmond"></table>');

                    // console.log('creating jqgrid for the first time');
                    $("#jqGridSearchBioP").jqGrid({
                        //url: "mssql_get_tbl_biop/",
                        //postData: get_queryData(biologicalCategory, exportFormat),
                        //mtype: 'POST',
                        //datatype: "json",
                        datatype: 'local',
                        data: theData,
                        colModel: colModelGen,
                        viewrecords: true,
                        width: 780,
                        pager: "#jqGridPagerSearchBioP",
                        gridview : true,
                        toolbar: [true, "top"],
                        rowNum : 15,
                        rowList : [15, 30, 45, 60, 50000],
                        autowidth : true,
                        height : 'auto',
                        sortname : 'Contractor',
                        sortorder : 'desc',
                        sortable : true,
                        caption : theCaption,
                        altRows: false,
                        ignoreCase: true,
                        shrinkToFit : false,
                        multiselect: false,
                        multiboxonly: false,
                        reloadAfterSubmit : false,
                        loadOnce : true,
                        hidegrid : false,
                        loadComplete: function(){
                            if($("#jqGridSearchBioP").jqGrid('getGridParam', 'records'))
                                theCaption = "Biological Point Records - (Showing " + $("#jqGridSearchBioP").jqGrid('getGridParam', 'records') + " records out of " + theCount + " total records)";
                            $("#jqGridSearchBioP").jqGrid('setCaption', theCaption);
                        }
                    }).jqGrid('navGrid',
                        '#jqGridPagerSearchBioP',
                        {
                            edit : false,
                            add : false,
                            del : false,
                            refresh : false,
                            search : true
                        },
                        {},
                        {},
                        {},
                        {
                            
                            closeOnEscape : true,
                            multipleSearch : true,
                            multipleGroup : true,
                            
                            width : 700,
                            recreateForm:true,
                            jqModal:true

                        });

                    $("#jqGridSearchBioP").jqGrid('filterToolbar', { stringResult: true, searchOperators: true, searchOnEnter: false, defaultSearch: "cn" });

                    $("#jqGridSearchBioP").jqGrid('navButtonAdd', '#jqGridPagerSearchBioP', {
                        caption: "Column Changer",

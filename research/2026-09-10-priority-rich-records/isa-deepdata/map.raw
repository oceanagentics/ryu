                        , "VP_DT_Stamp": "VP_DT_Stamp"
                        , "AreaOfImage": "Area of Image"
                        , "CameraSpecs": "Camera Specs"
                        , "Remarks": "Remarks"
                        //, "ObjectID": "ObjectIDFile"
                    };


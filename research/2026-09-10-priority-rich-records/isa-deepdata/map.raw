                            // alert("error");
                            // console.log('There was an error running data download zip file');
                            // console.log(err);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                        }
                    },
                    url: 'mssql_get_tbl_bio_pivot_combined',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'document',
                    type: 'POST',
                    contentType: "application/json",
                    data: queryData,
                    xhrFields:{
                        responseType: 'blob'
                    },
                    beforeSend: function (xxx) {

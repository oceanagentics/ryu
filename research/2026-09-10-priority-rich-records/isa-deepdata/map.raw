                                // console.log('whenLayerView completed');
                                // console.log(results);
                                queryPhotoPointsResultsLayer3.applyEdits({deleteFeatures: results.features});
                            })

                            if (layerType === '') {
                                get_photos('true', '', 'false', 'true', 'true');
                            }

                            //get_photos_results('true', '', 'false', 'true', 'true');

                            //if (layerType === 'biological')
                            //queryPointsLayerBiological(contractorIds, contractStatusIds, mineralTypesIds, locationsIds);
                            //queryLinesLayer(contractorIds, contractStatusIds, mineralTypesIds, locationsIds)

                            //if (layerType === 'geochemical')
                            //queryPointsLayerGeochemical(contractorIds, contractStatusIds, mineralTypesIds, locationsIds);

                            //if (layerType === 'biological' && bioType === 'Trawl')
                            //    queryLinesLayer(contractorIds, contractStatusIds, mineralTypesIds, locationsIds);

                            //get_stations("true", "", "false", "true")
                            //$("#processing-spinner").hide();
                            //$("#tabs").removeClass('disabledButton');
                        };
                    } catch(err) {
                        console.log(err);
                        //$("#processing-spinner").hide();
                       // $("#tabs").removeClass('disabledButton');
                    }
                }
                ,function(error){
                    console.log('There was an error loading the view');
                    console.log(error);
                    //$("#processing-spinner").hide();

                $("[id^=mineralTypes][id$=\"ALL\"]").addClass('fa-toggle-on');
            }else{
                $("[id^=mineralTypes][id$=\"ALL\"]").removeClass('fa-toggle-on');
                $("[id^=mineralTypes][id$=\"ALL\"]").addClass('fa-toggle-off');
            }
            $.each(data.mineral_types, function(key, data) {

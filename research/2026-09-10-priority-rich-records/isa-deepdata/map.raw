        function onSelectDiscipline(obj){
            $("#processing-spinner").show();
            $("#tabs").addClass('disabledButton');

            let theToggle = $(obj);
            if(theToggle[0].value === 'Biological'){
                $('#biologicalQuerySelection').show();
                $('#geochemicalQuerySelection').hide();
                $("#BioGridL").show();
                $("#BioGridP").hide();
                $("#GeoGrid").hide();

                $("#selectHabitatDiv").hide();
                $("#selectMatrixDiv").hide();

                get_tbl_biop_analysis();
                get_apei_lookup();
            }

            if(theToggle[0].value === 'Geochemical'){
                $('#biologicalQuerySelection').hide();
                $('#geochemicalQuerySelection').show();
                $("#BioGridL").hide();
                $("#BioGridP").hide();
                $("#GeoGrid").show();

                $("#selectHabitatDiv").hide();
                $("#selectMatrixDiv").hide();

                get_geochemical_categories();
                get_apei_lookup();
            }

            if(theToggle[0].value === 'Environmental Chemistry'){
                $('#biologicalQuerySelection').hide();
                $('#geochemicalQuerySelection').show();
                $("#BioGridL").hide();
                $("#BioGridP").hide();
                $("#GeoGrid").show();

                $("#selectHabitatDiv").hide();
                $("#selectMatrixDiv").show();

                get_habitat_types();
                get_matrix_types('Environmental Chemistry');
                get_geochemical_categories();
                get_apei_lookup();
            }
            $("#processing-spinner").hide();
            $("#tabs").removeClass('disabledButton');
        }

        // Get all the layers and tables
        function get_layers_tables(){
            $.ajax({
                url: 'get_layers_tables/',
                responseType: 'json',
                ajax: true,
                timeout: 30000,
                success: function (data) {
                    //console.log('get_layers_tables');
                    //console.log(data);
                    if(data['layers']){
                        $("#errorModal").hide();
                    }else{
                        $("#errorModal").empty();
                        $("#errorModal").append('There was an error connecting to the ArcGIS Server');
                        $("#errorModal").show();
                    }

                },
                error: function (error) {
                    $("#errorModal").empty();
                    $("#errorModal").append('There was an error connecting to the ArcGIS Server');
                    $("#errorModal").show();
                    console.log('There was an error connecting to the ArcGIS Server: ' + error['error']);
                }
            });
        }


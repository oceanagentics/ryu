        let createActionButtons = function(cellvalue, options, rowObject){

            let actionButtons = "<div style='display: flex;justify-content: space-between;'>";

            if(rowObject.FilePathIndividual) {
                actionButtons += "<button type='button' title='Download File' style='float:left' id='goDownload' class='btn btn-default' onclick=\"openExternalDownload('" + rowObject.ObjectID + "','" + rowObject.FileNameIndividual + "','" + rowObject.FilePathIndividual.split(':\\')[1].replace(/\\/g, '\\\\') + "');\"><i style='font-size:14px;float:left;pointer-events: none;' class='fa fa-download' aria-hidden='true'></i></button>";
            }else{
                actionButtons += "<button type='button' title='Download File' style='float:left' id='goDownload' class='btn btn-default' onclick=\"openExternalDownload();\" disabled><i style='font-size:14px;float:left;pointer-events: none;' class='fa fa-download' aria-hidden='true'></i></button>";
            }

            actionButtons += "</div>";
            return actionButtons;
        };

        // MSSQL Get tblGeochem
        function mssql_get_tblContracts(doExport, searchByApeiOnly){
            $("#processing-spinner").show();
            $("#tabs").addClass('disabledButton');
            //console.log('Fetching GeoChem Query');
            //let habitat = $('#selectHabitat').val();
            // console.log(habitat);

            let matrix = $('#selectMatrix').val();
            console.log(matrix);

            let geochemCategory = $('#selectGeochemicalCategory').val();
            // console.log(geochemCategory);

            let exportFormat = '';
            if(doExport){
                exportFormat = 'csv'
            }

            let theCaption = "Geo Records";

            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();
            // console.log('locationIds');
            // console.log(locationIds);
            let apei = $('#selectApei-Geochemical').val();
            let queryData = {'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds, 'GeochemicalCategory': geochemCategory, 'ExportFormat': exportFormat, 'QueryCount': 0, 'APEI': apei, 'searchByApeiOnly': searchByApeiOnly, 'MatrixType': matrix};
            // console.log(queryData);
            if(doExport){
                $.when($.ajax({
                    statusCode: {
                        500: function() {
                            // alert("error");
                            console.log('There was an error running data download zip file');
                            //console.log(error);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                            $("#processing-spinner").hide();
                            $("#tabs").removeClass('disabledButton');
                        }
                    },
                    url: 'mssql_get_tbl_geochem',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'document',
                    type: 'POST',
                    contentType: "application/json",
                    data: JSON.stringify(queryData),
                    xhrFields:{
                        responseType: 'blob'
                    },

                    success: function (data) {
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = 'geochem.zip';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function(){
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    },
                    error: function (error) {
                        console.log('There was an error running openExternalDownload: ' + error);
                        $("#processing-spinner").hide();
                        $("#tabs").removeClass('disabledButton');
                    }
                })).done(function(data, textStatus, jqXHR){
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }else{
                let cols = 	{"Contractor": "Contractor"
                    , "ContractType": "Mineral Type"
                    , "ContractNum": "Contract Number"
                    , "ContractStatus": "Contract Status"
                    , "Cruise_Leg": "Cruise_Leg"
                    , "StationID": "StationID"
                    , "TowID": "TowID"
                    , "APEI_ID": "APEI_ID"
                    , "SampleID": "SampleID"
                    , "VPFileName": "VPFileName"
                    , "Category": "Category"
                    , "Analysis": "Analysis"
                    , "Result": "Result"
                    , "Unit": "Unit"
                    , "CTD_Depth": "CTD Depth"
                    , "CTD_SampleDate": "CTD Sample Date"
                };

                let colModelGen = [];
                $.each(cols, function(k,v){
                    colModelGen.push({ label: v, name: k, index: k, width: 150, hidden: false })
                });

                $("#GeoGrid").show();
                $("#BioGridL").hide();
                $("#BioGridP").hide();

                let theCount = 0;
                queryData['QueryCount'] = 1;
                $.ajax({
                    url: 'mssql_get_tbl_geochem/',
                    timeout: 600000,
                    ajax: false,
                    responseType: 'json',
                    type: 'POST',
                    contentType: "application/json",
                    data: JSON.stringify(queryData),
                    statusCode: {
                        500: function() {
                            // alert("error");
                            console.log('There was an error running geological QueryCount');
                            //console.log(error);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                            $("#processing-spinner").hide();
                            $("#tabs").removeClass('disabledButton');
                        }
                    },
                    success: function (data) {
                        theCount = data['query_count'];
                    },
                    failure: function (error) {
                        console.log('There was an error running the query');
                        console.log(error);
                        $("#processing-spinner").hide();
                        $("#tabs").removeClass('disabledButton');
                    }
                });
                queryData['QueryCount'] = 0;

                let theData = [];
                $.when($.ajax({
                    url: 'mssql_get_tbl_geochem/',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'json',
                    type: 'POST',
                    contentType: "application/json",
                    data: JSON.stringify(queryData),
                    statusCode: {
                        500: function() {
                            // alert("error");
                            console.log('There was an error running geological query');
                            //console.log(error);
                            //$('#downloadsError').append('<p>An error occured finding the file to download: '+name+'</p>');
                            $("#processing-spinner").hide();
                            $("#tabs").removeClass('disabledButton');
                        }
                    },
                    success: function (data) {
                        theData = data;
                    },
                    failure: function (error) {
                        console.log('There was an error running the query');
                        console.log(error);
                        $("#processing-spinner").hide();
                        $("#tabs").removeClass('disabledButton');
                    }
                })).done(function(theData, textStatus, jqXHR){
                    $("#GeoGrid").empty();
                    $("#GeoGrid").append('<div id="jqGridPagerSearchGeo" class="redmond"></div>');
                    $("#GeoGrid").append('<table id="jqGridSearchGeo" class="redmond"></table>');
                    // }
                    // console.log('creating jqgrid for the first time');
                    $("#jqGridSearchGeo").jqGrid({
                        //url: "mssql_get_tbl_geochem/",
                        //postData: JSON.stringify(queryData),
                        //mtype: 'POST',
                        //datatype: "json",
                        datatype: 'local',
                        data: theData,
                        colModel: colModelGen,
                        viewrecords: true,
                        width: 780,
                        pager: "#jqGridPagerSearchGeo",
                        gridview : true,
                        toolbar: [true, "top"],
                        rowNum : 15,
                        rowList : [15, 30, 45, 60, 1000],
                        autowidth : true,
                        height : 'auto',
                        sortname : 'Contractor',
                        sortorder : 'desc',
                        sortable : true,
                        caption : theCaption,
                        altRows: false,
                        ignoreCase: true,
                        shrinkToFit : false,
                        multiselect: false,
                        multiboxonly: false,
                        reloadAfterSubmit : false,
                        loadOnce : false,
                        hidegrid : false,
                        loadComplete: function(){
                            //alert($("#jqGridSearchGeo").jqGrid('getGridParam', 'records'));
                            if($("#jqGridSearchGeo").jqGrid('getGridParam', 'records'))
                                theCaption = "Geo Records - (Showing " + $("#jqGridSearchGeo").jqGrid('getGridParam', 'records') + " records out of " + theCount + " total records)";
                            $("#jqGridSearchGeo").jqGrid('setCaption', theCaption);
                        }
                    });

                    $("#jqGridSearchGeo").jqGrid('navGrid',
                        '#jqGridPagerSearchGeo',
                        {
                            edit : false,
                            add : false,
                            del : false,
                            refresh : false,
                            search : true
                        },
                        {},
                        {},
                        {},
                        {
                            
                            closeOnEscape : true,
                            multipleSearch : true,
                            multipleGroup : true,
                            
                            width : 700,
                            recreateForm:true,
                            jqModal:true

                        });

                    $("#jqGridSearchGeo").jqGrid('filterToolbar', { stringResult: true, searchOperators: true, searchOnEnter: false, defaultSearch: "cn" });

                    $("#jqGridSearchGeo").jqGrid('navButtonAdd', '#jqGridPagerSearchGeo', {
                        caption: "Column Changer",
                        buttonicon: "ui-icon-calculator",
                        title: "Column Changer",
                        onClose: function () {
                            $("#mainNavToggler").click();
                        },
                        onClickButton: function () {
                            $("#mainNavToggler").click();
                            $(this).jqGrid('columnChooser',{
                                width: 700,
                                dialog_opts: {
                                    modal: true,
                                    minWidth: 470,
                                    
                                    show: 'blind',
                                    hide: 'explode',
                                    dividerLocation: 0.5
                                }
                            });
                            $("#colchooser_" + $.jgrid.jqID(this.id) + " ul.selected")
                                .bind("sortreceive", function (event, ui) {
                                    // alert('column "' + ui.item.text() + '" is chosen');
                                });
                            $("#colchooser_" + $.jgrid.jqID(this.id) + " ul.available a.action")
                                .click(function () {
                                    // alert('column "' + $(this).parent().text() + '" is chosen');
                                });
                        }
                    });
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }
        }

        // MSSQL Get tblGeochem
        function mssql_get_tblLibrary(doExport, isPhotoVideo){
            // console.log('Fetching Library Query');
            let theme = $('#selectTheme').val();
            $("#RunLibraryQueryExport").hide();
            // console.log(theme);

            let exportFormat = null;
            if(doExport){
                exportFormat = 'csv'
            }

            let contractorIds = get_layers_contractors_ids();
            let contractStatusIds = get_layers_contractStatus_ids();
            let sponsoringStateIds = get_layers_sponsoringState_ids();
            let mineralTypeIds = get_layers_mineralTypes_ids();
            let locationIds = get_layers_locations_ids();

            let theCaption = "Library Records";

            let queryData = {'ContractorIds': contractorIds, 'ContractStatusIds': contractStatusIds, 'SponsoringStateIds': sponsoringStateIds, 'MineralTypeIds': mineralTypeIds, 'LocationIds': locationIds, 'Theme': theme, 'ExportFormat': exportFormat, 'APEI': []};

            if(doExport){
                $.when($.ajax({
                    url: 'mssql_get_tbl_library/',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'document',
                    type: 'POST',
                    contentType: "application/json",
                    data: JSON.stringify(queryData),
                    xhrFields:{
                        responseType: 'blob'
                    },
                    success: function (data) {
                        //console.log('printing out export data');
                        //console.log(data);
                        let anchor = document.createElement('a');
                        let url = window.URL || window.webkitURL;
                        anchor.href = url.createObjectURL(data);
                        anchor.download = theme+'_library_export.csv';
                        document.body.append(anchor);
                        anchor.click();
                        setTimeout(function(){
                            document.body.removeChild(anchor);
                            url.revokeObjectURL(anchor.href);
                        }, 5);
                    },
                    failure: function (error) {
                        // console.log('There was an error running the query');
                        // console.log(error);
                    }
                })).done(function(data, textStatus, jqXHR){
                    //return data
                    $("#processing-spinner").hide();
                    $("#tabs").removeClass('disabledButton');
                });
            }else{

                let theData = [];
                $.when($.ajax({
                    url: 'mssql_get_tbl_library/',
                    timeout: 600000,
                    ajax: true,
                    responseType: 'json',
                    type: 'POST',
                    contentType: "application/json",
                    data: JSON.stringify(queryData),
                    success: function (data) {
                        theData = data;
                    },
                    failure: function (error) {
                        console.log('There was an error running the query');
                        console.log(error);
                    }
                })).done(function(theData, textStatus, jqXHR) {

                    // TODO: Add unique years to dropdown and show, use to populate filter in jqGrid

                    let cols = {

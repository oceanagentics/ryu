}
</style><style id="wp-custom-css">
/*class image with grey border*/
.img_border {
	border: 1px solid #e9e9e9;
}
.img_padding {
	padding-right: 10px;
}
.pbt-cat-new-row .publication-contents-card-bx .img-div img {
    border: 1px solid #d3d3d3;
}
img.attachment-medium.size-medium.wp-post-image {
    border: 1px solid #d3d3d3;
}

.column_with_border.wpb_column.vc_column_container.vc_col-sm-2 {
    border: 1px solid #e9e9e9;
}
input#miniorange_otp_token_submit {
    background: #ffb905;
    color: #fff;
}

.button_100 {
	width: 100% !important;
}

.wrkshp-evnt-right-sidebar-card #box-one a {
	font-size: 22px;
	padding: 0px;
	margin: 0px;
	line-height: 1.2;
}

.wrkshp-evnt-right-sidebar-card #box-one li {
	  margin: 0px;
    padding: 5px 0px;
    border-bottom: solid 1px #fff;
}

.wrkshp-evnt-right-sidebar-card .text-block-session-list-box a {
font-size: 22px !important;
} 

/* MSG Reflections - Fix all issues: card styling, text overflow, box shadow */
.blog #content-wrapper article.type-msg_reflections.entry,
.blog #content-wrapper article.post.entry {
    padding: 20px 20px;
    margin: 0 0 30px;
    position: relative;
    box-shadow: 0 3px 6px 0 #00000029;
    display: block;
    width: 100%;
    background: #fff;
    overflow: hidden;
}

/* Fix text overflow */
.blog #content-wrapper .entry-titles,
.blog #content-wrapper .entry-titles a {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    display: block;
}

.blog #content-wrapper .entry-content,
.blog #content-wrapper .entry-content p {
    word-wrap: break-word;
    word-break: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    overflow: hidden;
}

/* Ensure row and columns don't overflow */
.blog #content-wrapper .row {
    margin-left: -15px;
    margin-right: -15px;
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
}

.blog #content-wrapper .row > [class*="col-"] {
    padding-left: 15px;
    padding-right: 15px;
    max-width: 100%;
    overflow: hidden;
}

.blog #content-wrapper .col-md-4 {
    flex: 0 0 33.33333333%;
    max-width: 33.33333333%;
}

.blog #content-wrapper .col-md-8 {
    flex: 0 0 66.66666667%;
    max-width: 66.66666667%;
}

/* Ensure images don't break layout */
.blog #content-wrapper .post-thumbnail {
    max-width: 100%;
    overflow: hidden;
}

.blog #content-wrapper .post-thumbnail img {
    max-width: 100%;
    height: auto;
    display: block;
}

/* Responsive */
@media (max-width: 991px) {
    .blog #content-wrapper .col-md-4,
    .blog #content-wrapper .col-md-8 {
        flex: 0 0 100%;
        max-width: 100%;
    }
}

.image-pair {
  display: flex;
  gap: 0.5rem;
  margin: 1.5rem 0;
  width: 100%;
  align-items: flex-start;
}
.image-pair > span {
  flex: 1 1 0;
  min-width: 0;
}
.image-pair img {
  width: 100%;
  height: auto;
  display: block;
  vertical-align: middle;
}
@media (max-width: 600px) {
  .image-pair {
    flex-direction: column;
  }
  .image-pair > span {
    width: 100%;
  }
}


</style>

	} else {
		btn.removeClass('show');
	}
	});

	btn.on('click', function(e) {
	e.preventDefault();
	jQuery('html, body').animate({scrollTop:0}, '300');
	});



	/*jQuery(window).load(function() {
		jQuery(".loader-bg").fadeOut("slow");
	});*/

	jQuery('.search-form').submit(function(e){ 
	  e.preventDefault();

	  jQuery.ajax({
	      url: 'https://isa.org.jm/wp-admin/admin-ajax.php',
	      type: 'post',
	      data: { action: 'data_fetch', keyword: jQuery('#keyword').val() },
	      beforeSend: function(data){
	        jQuery('.loader-bg').show();
	      },
	      success: function(data) {
	      	jQuery('.loader-bg').hide();

	      	console.log(data);

	      	if(!jQuery.trim(data)) {
	      		jQuery('.view_content').html('<div class="alert alert-primary">No result found.</div>');
	      	} else {
	        	jQuery('.view_content').html( data );
	      	}
	      }
	  }); 
	});

	jQuery( document ).ready(function() {
	  jQuery('span.file a[href$="pdf"]').addClass('download-pdf');
	  jQuery('span.file a[href$="doc"]').addClass('download-doc');
	  jQuery('span.file a[href$="docx"]').addClass('download-docx');
	  
	  jQuery('span.file a[href$="pdf"]').attr('target','_blank');
	  jQuery('span.file a[href$="doc"]').attr('target','_blank');
	});

</script>

</body>
</html>


